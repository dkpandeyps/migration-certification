{
  "_comment": "Jira REST API v3 issue creation payload template. Replace {placeholders} with actual values.",
  "_api_endpoint": "POST {JIRA_URL}/rest/api/3/issue",
  "_auth_header": "Authorization: Basic {base64(email:api_token)}",

  "fields": {
    "project": {
      "key": "{JIRA_PROJECT_KEY}"
    },
    "summary": "[{module}] {title}",
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Environment: {environment}",
              "marks": [{"type": "strong"}]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {"type": "text", "text": "Discovered by: Automated Certification Framework | Test ID: {test_id}"}
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "heading",
          "attrs": {"level": 3},
          "content": [{"type": "text", "text": "Steps to Reproduce"}]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "_comment": "Repeat this listItem block for each step",
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{"type": "text", "text": "{step_text}"}]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {"level": 3},
          "content": [{"type": "text", "text": "Expected Result"}]
        },
        {
          "type": "paragraph",
          "content": [{"type": "text", "text": "{expected_result}"}]
        },
        {
          "type": "heading",
          "attrs": {"level": 3},
          "content": [{"type": "text", "text": "Actual Result"}]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "{actual_result}",
              "marks": [{"type": "textColor", "attrs": {"color": "#de350b"}}]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {"level": 3},
          "content": [{"type": "text", "text": "Evidence"}]
        },
        {
          "type": "paragraph",
          "content": [
            {"type": "text", "text": "Screenshots attached to this issue. See attachments tab."}
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "paragraph",
          "content": [
            {"type": "text", "text": "Auto-generated by /generate-jira-bugs | Session: {session_id} | Defect ID: {defect_id}"}
          ]
        }
      ]
    },
    "issuetype": {
      "name": "{issue_type}"
    },
    "priority": {
      "name": "{priority}"
    },
    "labels": [
      "certification",
      "auto-generated",
      "defect-id-{defect_id}"
    ],
    "environment": "{environment}"
  }
}
